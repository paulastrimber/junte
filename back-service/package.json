{
  "name": "junte-back-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "migrate:check": "node --env-file-if-exists=.env scripts/migrate-check.js",
    "seed": "node --env-file-if-exists=.env seeds/index.js",
    "catalogs:sync": "node --env-file-if-exists=.env scripts/sync-catalogs.js",
    "admin": "node --env-file-if-exists=.env scripts/admin.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^9.11.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "mongodb-memory-server": "^11.3.0",
    "neostandard": "^0.13.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "9.0.2"
    }
  }
}
