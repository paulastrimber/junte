# Copiar a .env para desarrollo local (`task setup` lo hace). En AWS los valores vienen de Secrets Manager.
# Nunca commitear valores de secretos.
NODE_ENV=development
PORT=3000
# Fuera de docker se usa directConnection (el miembro del replica set se llama mongo:27017).
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=junte
REDIS_URL=redis://localhost:6379
# Secreto: mínimo 32 caracteres. `task setup` genera uno aleatorio en .env.
JWT_SECRET=
LOG_LEVEL=info
# Opcional. Pesos del feed (formato pendiente, ver docs/pendientes.md#pesos-del-feed).
FEED_WEIGHTS=
