# Copiar a .env para desarrollo local (`task setup` lo hace). En AWS los valores vienen de Secrets Manager.
# Nunca commitear valores de secretos.
NODE_ENV=development
PORT=3000
# Fuera de docker se usa directConnection (el miembro del replica set se llama mongo:27017).
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=junte
REDIS_URL=redis://localhost:6379
# Secreto: mínimo 32 caracteres. `task setup` genera uno aleatorio en .env.
JWT_SECRET=
# Solo en AWS (las pone infra/templates/40-back.yml): nombre o ARN del secreto en Secrets Manager. Si están, el back
# lee de ahí JWT_SECRET y MONGO_URI al arrancar, con el rol de la instancia; no se definen junto con esos valores.
# En local quedan vacías.
JWT_SECRET_ID=
MONGO_URI_SECRET_ID=
# Opcional (S5): igual que las anteriores, para la cuenta de servicio de Firebase (completa FCM_SERVICE_ACCOUNT).
FCM_SERVICE_ACCOUNT_SECRET_ID=
# En AWS va en info (el valor por defecto): debug y trace son solo para desarrollo.
LOG_LEVEL=info
# Opcional. Pesos del score del feed en JSON; suman 1. Sin valor: {"interests":0.5,"distance":0.3,"schedule":0.2}.
FEED_WEIGHTS=
# Fotos de perfil en S3. Opcionales en desarrollo y test (sin ellas se usa un storage en memoria, que no persiste
# ni permite subir fotos desde la app); obligatorias con NODE_ENV=production. Van las dos juntas.
# Las credenciales NO se configuran acá: salen de la cadena por defecto del SDK de AWS / rol IAM de la instancia.
S3_BUCKET=
AWS_REGION=
# Avisos push (FCM). Secreto: el JSON de la cuenta de servicio de Firebase en UNA línea (Configuración del proyecto →
# Cuentas de servicio → Generar nueva clave privada). Opcional: sin valor los avisos no salen del back (se loguean).
# En AWS no va acá: sale de Secrets Manager con FCM_SERVICE_ACCOUNT_SECRET_ID.
FCM_SERVICE_ACCOUNT=
# Emails de recuperación de contraseña, por Resend (https://resend.com). Opcionales y van las dos juntas.
# RESEND_API_KEY es un secreto (API Keys → Create API Key, con permiso "Sending access"). MAIL_FROM es el remitente y su
# dominio tiene que estar verificado en Resend; si no, solo llegan emails a la dirección de la cuenta de Resend.
# Sin valores, en desarrollo el email no sale: se muestra en el log del back (ahí está el código). En AWS la clave no
# va acá: sale de Secrets Manager con RESEND_API_KEY_SECRET_ID.
RESEND_API_KEY=
MAIL_FROM=
RESEND_API_KEY_SECRET_ID=
# Solo para `task db:seed`: contraseña (hasheada con Argon2id) de los usuarios de ejemplo. `task setup` genera una aleatoria.
SEED_PASSWORD=
# ADMIN_PASSWORD no va acá: se pasa solo al crear una cuenta admin (ADMIN_PASSWORD=... npm run admin -- create <email> "<nombre>").
