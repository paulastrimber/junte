# Complementa el .gitignore de la raíz del repo.

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Carpetas nativas generadas (prebuild / expo run)
/ios
/android
.kotlin/

# Credenciales de firma: nunca en Git
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*
*.orig.*

# Variables locales
.env
.env*.local

# Firebase (avisos push, S5-MOB-04): config del proyecto. No va en Git; en EAS se carga como variable de tipo archivo
# GOOGLE_SERVICES_JSON (ver docs/arquitectura/05-mobile.md).
google-services.json
GoogleService-Info.plist
