{
  "name": "junte-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "axios": "^1.20.0",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-calendar": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@expo/env": "~2.4.3",
    "@testing-library/react-native": "^14.0.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "neostandard": "^0.13.0",
    "test-renderer": "^1.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "clearMocks": true,
    "testTimeout": 15000,
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}"
    ],
    "coverageThreshold": {
      "./src/hooks/": {
        "lines": 80
      }
    }
  }
}
