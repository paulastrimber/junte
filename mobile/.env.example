# Copiar a mobile/.env (no se commitea). Expo CLI lo carga en `npx expo start` / `expo export`.
# Solo variables EXPO_PUBLIC_* llegan al binario: NADA secreto acá.

# URL base de la API (Nginx local de docker-compose, puerto 8080, prefijo /api/v1).
# - Emulador Android: 10.0.2.2 es el localhost de la máquina host.
# - Simulador iOS: http://localhost:8080/api/v1
# - Teléfono físico: http://<IP-LAN-de-tu-máquina>:8080/api/v1 (misma red Wi-Fi).
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# Clave del SDK de Google Maps para Android (mapa de "crear plan"). Única excepción a "nada secreto": queda dentro del
# APK por diseño de Google, así que tiene que estar RESTRINGIDA en Google Cloud a esta app (paquete + SHA-1) y a
# "Maps SDK for Android". Sin valor, en local el mapa de Android se ve vacío. En EAS va como variable de entorno del
# proyecto (no en eas.json). Ver docs/arquitectura/09-seguridad.md.
GOOGLE_MAPS_ANDROID_API_KEY=
